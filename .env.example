# Copy this file to .env and fill in your values
# cp .env.example .env

# Timezone for the collectd container
TIMEZONE=Europe/Berlin

# Collectd check interval in seconds
CHECK_INTERVAL=3

# InfluxDB host IP
# Must be the actual host machine IP because the collectd container uses host networking
INFLUXDB_HOST=10.0.0.10
INFLUXDB_COLLECTD_PORT=25826

# InfluxDB admin credentials (created on first start)
# Use these same credentials when adding the InfluxDB datasource in Grafana
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=changeme

# FritzBox connection
FRITZBOX_IP=192.168.178.1
FRITZBOX_USER=collectd
FRITZBOX_PASSWORD=changeme

# Grafana admin credentials (default: admin/admin, change on first login)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
